{
  "name": "webshop-toolbox-platform-test",
  "account_id": "cab062dd85faea98c9b8c4969175c39f",
  "main": "platform/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "platform/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PLATFORM_ENV": "remote-test",
    "PLATFORM_AUTH": "cloudflare-access",
    "PLATFORM_EXTERNAL_WRITES": "blocked",
    "PLATFORM_CUSTOMER_EMAIL": "blocked",
    "PLATFORM_ACCESS_ISSUER": "https://flat-sun-0738.cloudflareaccess.com",
    "PLATFORM_ACCESS_AUD": "4edbc15bc801d85de33ef29839e2e3803b733ce3cebbe60728d8e3277982e646",
    "PLATFORM_INVITATION_MODE": "restricted",
    "PLATFORM_INVITATION_FROM": "no-reply@webshoptoolbox.dk",
    "PLATFORM_INVITATION_RECIPIENTS": "rj@itm8.com",
    "PLATFORM_MAIL_FROM": "faktura@webshoptoolbox.dk",
    "PLATFORM_MAIL_TEST_RECIPIENTS": "rj@itm8.com,rene.jeppesen@live.dk",
    "PLATFORM_CUSTOMER_LOGIN": "enabled",
    "PLATFORM_SIGNUP": "enabled"
  },
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "webshop-toolbox-platform-test",
      "database_id": "438fde65-c538-4719-aa2e-9502ae37c7e6",
      "migrations_dir": "platform/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PLATFORM_DOCUMENTS",
      "bucket_name": "webshop-toolbox-platform-test-documents"
    }
  ],
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": true
  },
  "send_email": [
    {
      "name": "PLATFORM_INVITATIONS",
      "allowed_sender_addresses": ["no-reply@webshoptoolbox.dk"],
      "allowed_destination_addresses": ["rj@itm8.com"]
    },
    {
      "name": "PLATFORM_MAIL_TEST",
      "allowed_sender_addresses": ["faktura@webshoptoolbox.dk"]
    },
    {
      "name": "PLATFORM_AUTH_MAIL",
      "allowed_sender_addresses": ["no-reply@webshoptoolbox.dk"],
      "allowed_destination_addresses": ["rj@itm8.com", "rene.jeppesen@live.dk"]
    }
  ],
  "routes": [
    {
      "pattern": "dev.webshoptoolbox.dk",
      "custom_domain": true
    }
  ]
}

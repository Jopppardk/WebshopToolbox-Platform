{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sablen-integrationshub",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "FEATURE_LOG_SERVICE_CLIENT_ID": "3ad3d5f8b0692ca8acc9cef0b5bca295.access",
    "CLOUDFLARE_ACCESS_TEAM_DOMAIN": "https://flat-sun-0738.cloudflareaccess.com",
    "CLOUDFLARE_ACCESS_AUD": "ddda465e15f3bae8973ad8ac8b8667c42cf01948d4a8ac5515bd6f10abcdc681",
    "DINERO_SALES_WRITES_ENABLED": "true",
    "DINERO_SALES_AUTOMATION_ENABLED": "true",
    "DINERO_SALES_START_AFTER": "2026-09-04T22:00:00Z",
    "DINERO_REFUND_WRITES_ENABLED": "true",
    "DINERO_REFUND_AUTOMATION_ENABLED": "true",
    "DINERO_DRAFT_TEST_ORDER_ID": "",
    "DINERO_PAYOUT_WRITES_ENABLED": "true",
    "DINERO_PAYOUT_AUTOMATION_ENABLED": "true",
    "DINERO_PAYOUT_START_AFTER": "2026-09-03T00:00:00Z"
  },
  "main": "worker-entry.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "INVOICES",
      "bucket_name": "sablen-invoices"
    }
  ],
  "send_email": [
    {
      "name": "INVOICE_EMAIL",
      "allowed_sender_addresses": ["faktura@sablen.dk"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sablen-integrationshub",
      "database_id": "154e8b5d-7f6c-42d7-b751-1defa0dd2549"
    }
  ],
  "routes": [
    {
      "pattern": "integration.sablen.dk",
      "custom_domain": true
    }
  ],
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] }
}

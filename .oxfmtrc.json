{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lock",
    "bun.lockb",
    "**/*.md",
    "platform/public/tier1-next/**",
    "platform/migrations/**",
    "scripts/lint-baseline.json",
    "scripts/format-baseline.json"
  ]
}

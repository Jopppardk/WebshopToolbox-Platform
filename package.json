{
  "name": "webshoptoolbox-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "test": "node --test lib/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "deploy:cloudflare": "node scripts/platform.mjs deploy",
    "lint": "node scripts/quality-ratchet.mjs",
    "format": "oxfmt",
    "platform:check": "node scripts/platform.mjs check",
    "platform:init": "node scripts/platform.mjs init-local",
    "platform:seed": "node scripts/platform.mjs seed-local",
    "platform:dev": "node scripts/platform.mjs dev",
    "platform:session": "node scripts/platform.mjs local-session",
    "platform:build": "node scripts/platform.mjs build",
    "platform:tier1:build": "vite build --config platform/tier1/vite.config.mjs",
    "platform:tier1:typecheck": "tsc --noEmit --project platform/tier1/tsconfig.json",
    "deploy:dev": "node scripts/platform.mjs deploy",
    "deploy:prod": "node scripts/platform-production.mjs deploy",
    "test:portal": "npm run platform:tier1:build && playwright test --config playwright.config.mjs",
    "lint:update": "node scripts/quality-ratchet.mjs --update"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "1.31.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "type": "module"
}

{
  "name": "webshop-toolbox-platform-production",
  "account_id": "cab062dd85faea98c9b8c4969175c39f",
  "main": "platform/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "platform/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PLATFORM_ENV": "production",
    "PLATFORM_AUTH": "cloudflare-access",
    "PLATFORM_EXTERNAL_WRITES": "enabled",
    "PLATFORM_CUSTOMER_EMAIL": "enabled",
    "PLATFORM_ACCESS_ISSUER": "https://flat-sun-0738.cloudflareaccess.com",
    "PLATFORM_ACCESS_AUD": "8029826e98be59c035aba9af67ee49560bea48baae6567048d989d16d465b72f",
    "PLATFORM_INVITATION_MODE": "registered",
    "PLATFORM_INVITATION_FROM": "no-reply@webshoptoolbox.dk",
    "PLATFORM_MAIL_FROM": "faktura@webshoptoolbox.dk",
    "PLATFORM_MAIL_TEST_RECIPIENTS": "rj@itm8.com,rene.jeppesen@live.dk,rene@sablen.dk",
    "PLATFORM_CUSTOMER_LOGIN": "enabled",
    "PLATFORM_SIGNUP": "enabled"
  },
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "webshop-toolbox-platform-production",
      "database_id": "c3775354-8cc9-4f68-9343-1bde30776245",
      "migrations_dir": "platform/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PLATFORM_DOCUMENTS",
      "bucket_name": "webshop-toolbox-platform-production-documents"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "limits": {
    "cpu_ms": 300000
  },
  "queues": {
    "producers": [
      {
        "binding": "PLATFORM_JOBS",
        "queue": "webshop-toolbox-platform-production-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "webshop-toolbox-platform-production-jobs",
        "max_batch_size": 1,
        "max_retries": 0,
        "max_concurrency": 10
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "send_email": [
    {
      "name": "PLATFORM_INVITATIONS",
      "allowed_sender_addresses": ["no-reply@webshoptoolbox.dk"]
    },
    {
      "name": "PLATFORM_MAIL_TEST",
      "allowed_sender_addresses": ["faktura@webshoptoolbox.dk"]
    },
    {
      "name": "PLATFORM_AUTH_MAIL",
      "allowed_sender_addresses": ["no-reply@webshoptoolbox.dk"]
    }
  ],
  "routes": [
    {
      "pattern": "portal.webshoptoolbox.dk",
      "custom_domain": true
    }
  ]
}

{
  "name": "webshop-toolbox-platform-local",
  "main": "platform/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "platform/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PLATFORM_ENV": "local-test",
    "PLATFORM_AUTH": "local-jwt",
    "PLATFORM_EXTERNAL_WRITES": "blocked",
    "PLATFORM_CUSTOMER_EMAIL": "blocked",
    "PLATFORM_INVITATION_MODE": "preview",
    "PLATFORM_CUSTOMER_LOGIN": "enabled",
    "PLATFORM_SIGNUP": "enabled"
  },
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "webshop-toolbox-platform-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "platform/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PLATFORM_DOCUMENTS",
      "bucket_name": "webshop-toolbox-platform-local-documents"
    }
  ],
  "triggers": {
    "crons": []
  }
}
